# Origin of the CMS API service (bf-backend running in CMS mode),
# without a trailing slash and without /cms/v1.
#
# The values in this file are also the defaults: a variable that is not set in the
# environment (.env.local, Vercel) is read from here at build time (see next.config.ts).
# Dev API by default; use http://localhost:8000 in .env.local for a local backend.
NEXT_PUBLIC_CMS_API_URL=https://dev.cms-api.bikeflip.com
