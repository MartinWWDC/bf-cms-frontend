{
  "permissions": {
    "additionalDirectories": ["../bf-backend", "../bf-frontend"],
    "allow": [
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Edit(../bf-backend/**)",
      "Edit(../bf-frontend/**)"
    ]
  }
}
